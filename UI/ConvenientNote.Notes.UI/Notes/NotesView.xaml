<UserControl x:Class="ConvenientNote.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:ConvenientNote.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="#F4F6F8">
        <Grid Visibility="{Binding WallVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#DFE4EA" BorderThickness="0,0,0,1" Padding="86,14,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="笔记" Foreground="#172033" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NotesSummary}"
                                       Margin="10,0,0,1"
                                       VerticalAlignment="Bottom"
                                       Foreground="#667085"
                                       FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="把零散想法留在便签墙，需要时展开认真书写" Margin="0,4,0,0" Foreground="#667085" FontSize="11" />
                    </StackPanel>
                    <Border x:Name="NotesSearchBox" Grid.Column="1" Height="44" Margin="28,0,16,0" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="搜索标题、正文或标签"
                                     Padding="4,10"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#344054"
                                     AutomationProperties.Name="搜索笔记" />
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="2"
                              Width="126"
                              Height="44"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTag}"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="标签筛选" />
                    <ComboBox Grid.Column="3"
                              Width="126"
                              Height="44"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableNotebooks}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedNotebookFilter}"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="笔记本筛选" />
                    <Menu Grid.Column="4"
                          Width="44"
                          Height="44"
                          Margin="0,0,10,0"
                          Padding="0"
                          VerticalAlignment="Center"
                          Background="#F8FAFC"
                          BorderBrush="#D8DEE8"
                          BorderThickness="1">
                        <MenuItem x:Name="NotesTransferMenu"
                                  Width="44"
                                  Height="44"
                                  Padding="10"
                                  AutomationProperties.Name="笔记导入导出"
                                  ToolTip="笔记导入导出">
                            <MenuItem.Header>
                                <materialDesign:PackIcon Kind="ImportExport"
                                                         Width="20"
                                                         Height="20"
                                                         Foreground="#475467" />
                            </MenuItem.Header>
                            <MenuItem Header="导出笔记"
                                      AutomationProperties.Name="导出笔记"
                                      Click="ExportNotesMenuItem_Click" />
                            <MenuItem Header="导入笔记"
                                      AutomationProperties.Name="导入笔记"
                                      Click="ImportNotesMenuItem_Click" />
                        </MenuItem>
                    </Menu>
                    <Button x:Name="NewNoteButton"
                            Grid.Column="5"
                            Height="44"
                            MinWidth="116"
                            Padding="14,0"
                            Background="#3F51B5"
                            Foreground="White"
                            BorderBrush="#3F51B5"
                            Command="{Binding NewNoteCommand}"
                            AutomationProperties.Name="新建笔记">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Text="新建笔记" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="360" MinWidth="300" MaxWidth="520" />
                </Grid.ColumnDefinitions>
                <views:NoteWallControl />
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整知识点便签宽度" />
                <views:KnowledgeMemoControl x:Name="KnowledgeMemo" Grid.Column="2" Margin="0,20,20,20" />
            </Grid>
        </Grid>
        <views:RichNoteEditorControl x:Name="EditorControl" Visibility="{Binding EditorVisibility}" />
    </Grid>
</UserControl>
