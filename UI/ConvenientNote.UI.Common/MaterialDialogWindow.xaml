<Window x:Class="ConvenientNote.UI.Common.MaterialDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="488" SizeToContent="Height" FontFamily="Microsoft YaHei UI" Foreground="#202534">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="ScrollControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <materialDesign:Card Margin="16" Padding="24" Background="White" UniformCornerRadius="12">
        <materialDesign:Card.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.18" />
        </materialDesign:Card.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        Margin="12,-4,-8,-4" Click="Dismiss" ToolTip="关闭" AutomationProperties.Name="关闭弹窗">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#616B7E" />
                </Button>
            </Grid>
            <ContentPresenter x:Name="Body" />
        </StackPanel>
    </materialDesign:Card>
</Window>
