<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="UnifiedScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
        <Setter Property="Width" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Margin" Value="0,12,6,12" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbWidth" Value="4" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbHeight" Value="4" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="3" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="18" />
                <Setter Property="MinHeight" Value="18" />
                <Setter Property="Margin" Value="12,0,12,6" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="materialDesign:ScrollBarAssist.ThumbWidth" Value="6" />
                <Setter Property="materialDesign:ScrollBarAssist.ThumbHeight" Value="6" />
            </Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True">
                <Setter Property="materialDesign:ScrollBarAssist.ThumbWidth" Value="6" />
                <Setter Property="materialDesign:ScrollBarAssist.ThumbHeight" Value="6" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBar}" />
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}" />
</ResourceDictionary>
