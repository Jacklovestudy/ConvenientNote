<Window x:Class="ConvenientNote.Views.EventEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ConvenientNote.Views" Title="日程详情" Width="640" Height="680" MinWidth="450" MinHeight="460"
 Background="#F4F6FB" Foreground="#202638" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="BatchLabel" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#596681"/>
  <local:ItineraryDraftEditor x:Name="Editor" Grid.Row="1"/>
  <TextBlock x:Name="Error" Grid.Row="2" Foreground="#AB263E" TextWrapping="Wrap" Margin="0,10"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/><Button x:Name="Save" Content="保存修改" Click="SaveClicked" Padding="16,6"/></StackPanel>
 </Grid>
</Window>
