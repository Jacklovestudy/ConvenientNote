<UserControl x:Class="ConvenientNote.DesktopPet.UI.DesktopPetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ConvenientNote.DesktopPet.UI"
             Background="#F7F8FC" Foreground="#202534">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,8,10" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="980">
            <TextBlock Text="鹈鹕桌宠" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="一条红围巾，一辆绿单车。让它陪你慢慢过一天。" Foreground="#576474" FontSize="14" Margin="0,8,0,24" TextWrapping="Wrap" />
            <Border Background="White" BorderBrush="#DEE5E0" BorderThickness="1" CornerRadius="16" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <Border Background="#EDF3EC" CornerRadius="12" Margin="0,0,28,0" MinHeight="330">
                        <Grid>
                            <Ellipse Fill="#DDE7D9" Height="12" Width="250" VerticalAlignment="Bottom" Margin="0,0,0,25" />
                            <local:PelicanVisual x:Name="Preview" Margin="14" MaxWidth="380" MaxHeight="330" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="今天也不着急" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="鼠标停在身上会歪头，来回摸头会眯眼。&#10;打盹时在头上停留，可以轻轻唤醒它。&#10;单击歪头、双击加速，按住拖动，右键休息。" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="#576474" Margin="0,12,0,22" />
                        <Button Content="{Binding ToggleLabel}" Click="TogglePet" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" Padding="22,8" Height="40" />
                        <CheckBox Content="允许在当前屏幕自动骑行" IsChecked="{Binding Roaming, Mode=OneWay}" Click="ToggleRoaming" Margin="0,24,0,20" />
                        <DockPanel>
                            <TextBlock Text="桌宠大小" />
                            <TextBlock Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="#576474" />
                        </DockPanel>
                        <Slider x:Name="SizeSlider" Minimum="0.6" Maximum="1.6" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Scale, Mode=OneWay}" ValueChanged="PetSizeChanged" Margin="0,8,0,0" AutomationProperties.Name="桌宠大小" />
                        <DockPanel Margin="0,20,0,0">
                            <TextBlock Text="骑行速度" />
                            <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0} 像素/秒}" HorizontalAlignment="Right" Foreground="#576474" />
                        </DockPanel>
                        <Slider x:Name="SpeedSlider" Minimum="10" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding RidingSpeed, Mode=OneWay}" ValueChanged="RidingSpeedChanged" Margin="0,8,0,0" AutomationProperties.Name="骑行速度" />
                        <TextBlock Text="双击加速至设定速度的 2 倍" Foreground="#576474" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#576474" Margin="0,14,0,26" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="试试它的动作" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="下面只演示动作，不会移动桌面上的鹈鹕。" Foreground="#576474" Margin="0,6,0,16" />
            <WrapPanel>
                <Button Content="慢骑" Tag="Ride" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="加速" Tag="Boost" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="刹车" Tag="Brake" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="歪头" Tag="React" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="拎起" Tag="Drag" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="打盹" Tag="Sleep" Click="Play" Style="{StaticResource ActionButton}" />
                <Button Content="撞墙" Tag="Crash" Click="Play" Style="{StaticResource ActionButton}" />
            </WrapPanel>
            <TextBlock Text="90 秒没有互动会打盹。显示状态、大小、速度和位置会被记住；退出软件时，鹈鹕也会一起回家。"
                       TextWrapping="Wrap" Foreground="#576474" FontSize="12" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
