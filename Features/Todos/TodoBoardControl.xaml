<UserControl x:Class="ConvenientNote.Views.TodoBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="BoardScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource BoardScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{TemplateBinding Foreground}"
                                           Style="{StaticResource BoardScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource BoardScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="Root" Property="Width" Value="12" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageUpCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageDownCommand}" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Height" Value="12" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="12" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderThickness="0"
                Padding="96,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Height="46"
                        VerticalAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#EEF2F6"
                        BorderThickness="1"
                        CornerRadius="7"
                        IsEnabled="{Binding CanAddTodo}">
                    <TextBox materialDesign:HintAssist.Hint="添加事件，按回车创建"
                             Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
                             Padding="20,12"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#344054"
                             FontSize="14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <Button Grid.Column="1"
                        Height="46"
                        MinWidth="112"
                        Margin="12,0,0,0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        Foreground="#344054"
                        Cursor="Hand"
                        IsEnabled="{Binding CanArrangeTodos}"
                        Click="ArrangeTodosButton_Click"
                        ToolTip="按当前位置从上到下、从左到右重新排列">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ViewGridOutline"
                                                 Width="19"
                                                 Height="19"
                                                 VerticalAlignment="Center"
                                                 Foreground="#3F51B5" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="整理便签"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="2"
                        Height="46"
                        MinWidth="194"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#EEF2F6"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource TopIconButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding PreviousMonthCommand}"
                                ToolTip="上个月">
                            <materialDesign:PackIcon Kind="ChevronLeft"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="#CBD5E1" />
                        </Button>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CalendarMonth"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Foreground="#56B7B3" />
                            <TextBlock Text="{Binding CalendarMonthTitle}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#56B7B3"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource TopIconButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding NextMonthCommand}"
                                ToolTip="下个月">
                            <materialDesign:PackIcon Kind="ChevronRight"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="#CBD5E1" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="3"
                        MinWidth="148"
                        Height="46"
                        Margin="18,0,0,0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#EEF2F6"
                        BorderThickness="1"
                        CornerRadius="7"
                        ToolTip="{Binding WeatherToolTip}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding WeatherIconKind}"
                                                 Width="22"
                                                 Height="22"
                                                 VerticalAlignment="Center"
                                                 Foreground="#14A6A6" />
                        <TextBlock Text="{Binding WeatherText}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#344054"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20"
                Background="#EEF2F6"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid Background="#F8FAFC">
                <ScrollViewer x:Name="TodoBoardScrollViewer"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible"
                              CanContentScroll="False"
                              PanningMode="Both">
                    <ScrollViewer.Resources>
                        <Style BasedOn="{StaticResource BoardScrollBarStyle}"
                               TargetType="{x:Type ScrollBar}" />
                    </ScrollViewer.Resources>
                    <Grid x:Name="TodoBoard"
                          Width="{Binding BoardWidth}"
                          Height="{Binding BoardHeight}"
                          Background="#F8FAFC">
                        <ItemsControl x:Name="TodoItemsControl"
                                      Width="{Binding BoardWidth}"
                                      Height="{Binding BoardHeight}"
                                      ItemsSource="{Binding TodoItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="#F8FAFC" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            Background="{Binding Color}"
                                            BorderBrush="#D6B84F"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Cursor="SizeAll"
                                            RenderTransformOrigin="0.5,0.5"
                                            PreviewMouseLeftButtonDown="TodoCard_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="TodoCard_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="TodoCard_PreviewMouseLeftButtonUp">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="删除便签"
                                                          Foreground="#B42318"
                                                          Click="TodoDeleteMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                 Foreground="#B42318" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         FontSize="15"
                                                         FontWeight="SemiBold"
                                                         Foreground="#111827"
                                                         LostFocus="TodoTitle_LostFocus">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="剪切"
                                                                      Command="ApplicationCommands.Cut"
                                                                      InputGestureText="Ctrl+X" />
                                                            <MenuItem Header="复制"
                                                                      Command="ApplicationCommands.Copy"
                                                                      InputGestureText="Ctrl+C" />
                                                            <MenuItem Header="粘贴"
                                                                      Command="ApplicationCommands.Paste"
                                                                      InputGestureText="Ctrl+V" />
                                                            <MenuItem Header="全选"
                                                                      Command="ApplicationCommands.SelectAll"
                                                                      InputGestureText="Ctrl+A" />
                                                            <Separator />
                                                            <MenuItem Header="删除便签"
                                                                      Foreground="#B42318"
                                                                      Click="TodoDeleteMenuItem_Click">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                             Foreground="#B42318" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                                <Button Grid.Column="2"
                                                        Width="20"
                                                        Height="20"
                                                        MinWidth="20"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding PriorityLabel}"
                                                        Click="PriorityButton_Click">
                                                    <Border Width="14"
                                                            Height="14"
                                                            Background="{Binding PriorityBrush}"
                                                            BorderBrush="#FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000"
                                                                              BlurRadius="4"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.18" />
                                                        </Border.Effect>
                                                    </Border>
                                                </Button>
                                            </Grid>

                                            <TextBox Grid.Row="1"
                                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="补充说明"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="#475467"
                                                     Margin="24,8,0,0"
                                                     LostFocus="TodoContent_LostFocus">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="剪切"
                                                                  Command="ApplicationCommands.Cut"
                                                                  InputGestureText="Ctrl+X" />
                                                        <MenuItem Header="复制"
                                                                  Command="ApplicationCommands.Copy"
                                                                  InputGestureText="Ctrl+C" />
                                                        <MenuItem Header="粘贴"
                                                                  Command="ApplicationCommands.Paste"
                                                                  InputGestureText="Ctrl+V" />
                                                        <MenuItem Header="全选"
                                                                  Command="ApplicationCommands.SelectAll"
                                                                  InputGestureText="Ctrl+A" />
                                                        <Separator />
                                                        <MenuItem Header="删除便签"
                                                                  Foreground="#B42318"
                                                                  Click="TodoDeleteMenuItem_Click">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                         Foreground="#B42318" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas x:Name="AlignmentGuideLayer"
                                Width="{Binding BoardWidth}"
                                Height="{Binding BoardHeight}"
                                Panel.ZIndex="50"
                                IsHitTestVisible="False"
                                ClipToBounds="True">
                            <Line x:Name="VerticalAlignmentGuide"
                                  Stroke="#2563EB"
                                  StrokeThickness="1.5"
                                  StrokeDashArray="5 3"
                                  Opacity="0"
                                  SnapsToDevicePixels="True">
                                <Line.Effect>
                                    <DropShadowEffect Color="#2563EB"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.85" />
                                </Line.Effect>
                            </Line>
                            <Line x:Name="HorizontalAlignmentGuide"
                                  Stroke="#2563EB"
                                  StrokeThickness="1.5"
                                  StrokeDashArray="5 3"
                                  Opacity="0"
                                  SnapsToDevicePixels="True">
                                <Line.Effect>
                                    <DropShadowEffect Color="#2563EB"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.85" />
                                </Line.Effect>
                            </Line>
                        </Canvas>

                        <TextBlock Text="画布区"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,18,14"
                                   Foreground="#98A2B3"
                                   FontSize="12" />
                    </Grid>
                </ScrollViewer>

                <Grid Panel.ZIndex="40"
                      Visibility="{Binding EmptyStateVisibility}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="360">
                        <materialDesign:PackIcon Kind="NoteTextOutline"
                                                 Width="44"
                                                 Height="44"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#3F51B5" />
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#111827"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#667085"
                                   FontSize="13" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
