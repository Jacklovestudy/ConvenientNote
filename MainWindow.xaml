<Window x:Class="ConvenientNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ConvenientNote"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title, FallbackValue=Convenient Note}"
        Height="720"
        Width="1180"
        MinHeight="620"
        MinWidth="960"
        Icon="Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0"
                                  Mode="PrimaryMid"
                                  Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="NoteTextOutline"
                                             Width="22"
                                             Height="22"
                                             VerticalAlignment="Center"
                                             Foreground="White" />
                    <TextBlock Text="{Binding Title, FallbackValue=Convenient Note}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click">
                        <materialDesign:PackIcon Kind="WindowMinimize"
                                                 Width="16"
                                                 Height="16" />
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeRestoreButton_Click">
                        <materialDesign:PackIcon x:Name="MaximizeRestoreIcon"
                                                 Kind="WindowMaximize"
                                                 Width="16"
                                                 Height="16" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="CloseButton_Click">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="16"
                                                 Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <materialDesign:DrawerHost Grid.Row="1"
                                   OpenMode="Modal"
                                   IsLeftDrawerOpen="{Binding IsNavigationExpanded, Mode=TwoWay}"
                                   LeftDrawerCloseOnClickAway="True"
                                   LeftDrawerBackground="White">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Border Width="296"
                        Background="White"
                        BorderBrush="#DFE4EA"
                        BorderThickness="0,0,1,0"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Convenient Note"
                                           Foreground="#111827"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorkspaceName}"
                                           Margin="0,4,0,0"
                                           Foreground="#667085"
                                           FontSize="12" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    MinWidth="36"
                                    Padding="0"
                                    Command="{Binding ToggleNavigationCommand}"
                                    ToolTip="关闭导航">
                                <materialDesign:PackIcon Kind="ChevronLeft"
                                                         Width="20"
                                                         Height="20" />
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Margin="0,20,0,12"
                                 materialDesign:HintAssist.Hint="搜索"
                                 BorderBrush="#D0D5DD"
                                 BorderThickness="1"
                                 Padding="10,7" />

                        <ListBox Grid.Row="2"
                                 x:Name="NavigationListBox"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding ActiveNavigationItem, Mode=TwoWay}"
                                 PreviewKeyDown="NavigationListBox_PreviewKeyDown"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NavigationItem_PreviewMouseLeftButtonDown" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,9" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                     Width="22"
                                                                     Height="22"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#3F51B5" />

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#1F2937"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,2,0,0"
                                                           Foreground="#667085"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,14,0,0">
                            <Button Content="已达成"
                                    Margin="0,0,8,0"
                                    Padding="8,6"
                                    Tag="{x:Static local:NavigationSection.Completed}"
                                    Click="NavigationShortcut_Click" />
                            <Button Content="回收站"
                                    Padding="8,6"
                                    Tag="{x:Static local:NavigationSection.Trash}"
                                    Click="NavigationShortcut_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <Grid>
                <ContentControl x:Name="MainRegionContent" prism:RegionManager.RegionName="MainRegion" />

                <Button Width="42"
                        Height="42"
                        MinWidth="42"
                        Margin="20,14,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Background="#3F51B5"
                        BorderBrush="#3F51B5"
                        Foreground="White"
                        Command="{Binding ToggleNavigationCommand}"
                        AutomationProperties.Name="打开导航"
                        ToolTip="打开导航">
                    <materialDesign:PackIcon Kind="Menu"
                                             Width="24"
                                             Height="24" />
                </Button>
            </Grid>
        </materialDesign:DrawerHost>
    </Grid>
</Window>
