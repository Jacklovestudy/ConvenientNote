<UserControl x:Class="ConvenientNote.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#DFE4EA" BorderThickness="0,0,0,1" Padding="96,14,20,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewTitle}" Foreground="#172033" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ViewDescription}" Margin="0,4,0,0" Foreground="#667085" FontSize="12" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <ItemsControl ItemsSource="{Binding DeletedNotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Height="178" Margin="0,0,14,14" Padding="16" Background="{Binding Color}" CornerRadius="10" BorderBrush="#D6B84F" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" Foreground="#172033" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Margin="0,10" Text="{Binding Preview}" Foreground="#475467" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="恢复" Margin="0,0,8,0" Padding="12,6" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="彻底删除" Padding="12,6" Foreground="#B42318" Command="{Binding DataContext.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyVisibility}">
                <materialDesign:PackIcon Kind="DeleteEmptyOutline" Width="56" Height="56" HorizontalAlignment="Center" Foreground="#3F51B5" />
                <TextBlock Text="回收站是空的" Margin="0,16,0,0" TextAlignment="Center" Foreground="#172033" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="从笔记编辑器删除的内容会先来到这里。" Margin="0,8,0,0" TextAlignment="Center" Foreground="#667085" FontSize="13" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
