<UserControl x:Class="ConvenientNote.Views.NoteWallControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="#F4F6F8">
        <Border Margin="20"
                Background="#F8FAFC"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <Grid Width="1800" Height="1100" Background="#F8FAFC">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}"
                                  Width="1800"
                                  Height="1100">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="#F8FAFC" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Padding="16"
                                        Background="{Binding Color}"
                                        BorderBrush="#D6B84F"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Card_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="打开笔记" Click="OpenMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="OpenInNew" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="移到回收站" Foreground="#B42318" Click="DeleteMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#B42318" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#172033"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Pin"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Margin="6,0,0,0"
                                                                         Foreground="#3F51B5">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <materialDesign:PackIcon Kind="Star"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Margin="6,0,0,0"
                                                                         Foreground="#D97706">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,12,0,8"
                                                   Text="{Binding Preview}"
                                                   Foreground="#344054"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NotebookName}"
                                                           Foreground="#3F51B5"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TagsText}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#667085"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UpdatedText}"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="#667085"
                                                       FontSize="10" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Width="380"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding EmptyVisibility}">
                        <materialDesign:PackIcon Kind="NotebookEditOutline"
                                                 Width="56"
                                                 Height="56"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#3F51B5" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="开始写第一篇笔记"
                                   TextAlignment="Center"
                                   Foreground="#172033"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="点击“新建笔记”，然后双击便签进入大编辑器。"
                                   TextAlignment="Center"
                                   Foreground="#667085"
                                   FontSize="13" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
