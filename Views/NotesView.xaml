<UserControl x:Class="ConvenientNote.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:ConvenientNote.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="#F4F6F8">
        <Grid Visibility="{Binding WallVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#DFE4EA" BorderThickness="0,0,0,1" Padding="86,14,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="笔记" Foreground="#172033" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="把零散想法留在便签墙，需要时展开认真书写" Margin="0,4,0,0" Foreground="#667085" FontSize="11" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="44" Margin="28,0,16,0" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="搜索标题、正文或标签"
                                     Padding="4,10"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#344054"
                                     AutomationProperties.Name="搜索笔记" />
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="2"
                              Width="126"
                              Height="44"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTag}"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="标签筛选" />
                    <ComboBox Grid.Column="3"
                              Width="126"
                              Height="44"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableNotebooks}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedNotebookFilter}"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="笔记本筛选" />
                    <Button Grid.Column="4"
                            Height="44"
                            MinWidth="116"
                            Padding="14,0"
                            Background="#3F51B5"
                            Foreground="White"
                            BorderBrush="#3F51B5"
                            Command="{Binding NewNoteCommand}"
                            AutomationProperties.Name="新建笔记">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Text="新建笔记" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <views:NoteWallControl Grid.Row="1" />
        </Grid>
        <views:RichNoteEditorControl x:Name="EditorControl" Visibility="{Binding EditorVisibility}" />
    </Grid>
</UserControl>
