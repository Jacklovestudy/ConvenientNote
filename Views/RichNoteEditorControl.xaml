<UserControl x:Class="ConvenientNote.Views.RichNoteEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documents="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             PreviewKeyDown="RichNoteEditorControl_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="EditorToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#DFE4EA" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" />
                <TextBox x:Name="TitleTextBox"
                         Grid.Column="1"
                         Margin="16,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="EditorContentChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#172033"
                         FontSize="22"
                         FontWeight="SemiBold"
                         AutomationProperties.Name="笔记标题" />
                <StackPanel x:Name="HeaderActionsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HeaderBackButton"
                            Style="{StaticResource EditorToolButton}"
                            MinWidth="82"
                            Margin="0,0,14,0"
                            Click="BackButton_Click"
                            ToolTip="保存并返回笔记墙 (Esc)"
                            AutomationProperties.Name="返回笔记墙">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="返回" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SaveStatus}" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#667085" FontSize="12" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding TogglePinnedCommand}" ToolTip="置顶笔记">
                        <materialDesign:PackIcon Kind="PinOutline" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding ToggleFavoriteCommand}" ToolTip="收藏笔记">
                        <materialDesign:PackIcon Kind="StarOutline" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding MoveToTrashCommand}" ToolTip="移到回收站">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="#B42318" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="18,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ParagraphStyleComboBox" Width="110" Height="34" SelectedIndex="0" SelectionChanged="ParagraphStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="正文" Tag="15" />
                        <ComboBoxItem Content="标题 1" Tag="28" />
                        <ComboBoxItem Content="标题 2" Tag="22" />
                        <ComboBoxItem Content="标题 3" Tag="18" />
                    </ComboBox>
                    <Button Style="{StaticResource EditorToolButton}" Click="SetHeadingButton_Click" Content="章节" ToolTip="设为一级章节标题 (Ctrl+Alt+1)，正文 Ctrl+Alt+0" />
                    <Button x:Name="InsertCodeBlockButton" Style="{StaticResource EditorToolButton}" Click="InsertCodeBlockButton_Click" Content="代码块" ToolTip="插入 C# 代码块；选中文字可转换为代码块" />
                    <Button x:Name="InlineCodeButton" Style="{StaticResource EditorToolButton}" Click="InlineCodeButton_Click" Content="行内代码" ToolTip="将选中的同段文字设为行内代码，再点一次取消" />
                    <ComboBox x:Name="FontSizeComboBox"
                              Width="76"
                              Height="34"
                              Margin="8,0,0,0"
                              ToolTip="字号"
                              AutomationProperties.Name="字号"
                              SelectionChanged="FontSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="12" Tag="12" />
                        <ComboBoxItem Content="14" Tag="14" />
                        <ComboBoxItem Content="15" Tag="15" IsSelected="True" />
                        <ComboBoxItem Content="16" Tag="16" />
                        <ComboBoxItem Content="18" Tag="18" />
                        <ComboBoxItem Content="20" Tag="20" />
                        <ComboBoxItem Content="22" Tag="22" />
                        <ComboBoxItem Content="24" Tag="24" />
                        <ComboBoxItem Content="28" Tag="28" />
                        <ComboBoxItem Content="32" Tag="32" />
                        <ComboBoxItem Content="36" Tag="36" />
                    </ComboBox>
                    <ComboBox x:Name="LineSpacingComboBox"
                              Width="88"
                              Height="34"
                              Margin="8,0,0,0"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              ToolTip="行距（可输入 0.8–3.0）"
                              AutomationProperties.Name="行距"
                              SelectionChanged="LineSpacingComboBox_SelectionChanged"
                              LostKeyboardFocus="LineSpacingComboBox_LostKeyboardFocus"
                              PreviewKeyDown="LineSpacingComboBox_PreviewKeyDown">
                        <ComboBoxItem Content="行距 1.0" Tag="1.0" IsSelected="True" />
                        <ComboBoxItem Content="行距 1.15" Tag="1.15" />
                        <ComboBoxItem Content="行距 1.5" Tag="1.5" />
                        <ComboBoxItem Content="行距 2.0" Tag="2.0" />
                        <ComboBoxItem Content="行距 2.5" Tag="2.5" />
                        <ComboBoxItem Content="行距 3.0" Tag="3.0" />
                    </ComboBox>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleBold}" CommandTarget="{Binding ElementName=Editor}" ToolTip="粗体 (Ctrl+B)"><TextBlock Text="B" FontWeight="Bold" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleItalic}" CommandTarget="{Binding ElementName=Editor}" ToolTip="斜体 (Ctrl+I)"><TextBlock Text="I" FontStyle="Italic" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleUnderline}" CommandTarget="{Binding ElementName=Editor}" ToolTip="下划线 (Ctrl+U)"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Click="StrikethroughButton_Click" ToolTip="删除线"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleBullets}" CommandTarget="{Binding ElementName=Editor}" ToolTip="项目符号"><materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleNumbering}" CommandTarget="{Binding ElementName=Editor}" ToolTip="编号列表"><materialDesign:PackIcon Kind="FormatListNumbered" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignLeft}" CommandTarget="{Binding ElementName=Editor}" ToolTip="左对齐"><materialDesign:PackIcon Kind="FormatAlignLeft" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignCenter}" CommandTarget="{Binding ElementName=Editor}" ToolTip="居中"><materialDesign:PackIcon Kind="FormatAlignCenter" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignRight}" CommandTarget="{Binding ElementName=Editor}" ToolTip="右对齐"><materialDesign:PackIcon Kind="FormatAlignRight" Width="20" Height="20" /></Button>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Click="TextColorButton_Click" ToolTip="切换文字颜色"><materialDesign:PackIcon Kind="FormatColorText" Width="20" Height="20" Foreground="#3F51B5" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Click="InsertImageButton_Click" ToolTip="插入本地图片"><materialDesign:PackIcon Kind="ImagePlus" Width="20" Height="20" /></Button>
                    <Button x:Name="UndoEditorButton" Style="{StaticResource EditorToolButton}" Click="UndoEditorButton_Click" ToolTip="撤销 (Ctrl+Z)"><materialDesign:PackIcon Kind="Undo" Width="20" Height="20" /></Button>
                    <Button x:Name="RedoEditorButton" Style="{StaticResource EditorToolButton}" Click="RedoEditorButton_Click" ToolTip="重做 (Ctrl+Y)"><materialDesign:PackIcon Kind="Redo" Width="20" Height="20" /></Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="0">
                <Grid x:Name="EditorZoomViewport" ClipToBounds="True" PreviewMouseWheel="EditorZoomViewport_PreviewMouseWheel">
                <Grid x:Name="EditorZoomSurface">
                    <Grid.LayoutTransform><ScaleTransform x:Name="EditorZoomTransform" ScaleX="1" ScaleY="1" /></Grid.LayoutTransform>
                <RichTextBox x:Name="Editor"
                             Padding="28,24"
                             BorderThickness="0"
                             Background="White"
                             Foreground="#172033"
                             FontFamily="Segoe UI"
                             FontSize="15"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             AcceptsTab="True"
                             IsDocumentEnabled="True"
                             AllowDrop="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="EditorContentChanged"
                             SelectionChanged="Editor_SelectionChanged"
                             PreviewKeyDown="Editor_PreviewKeyDown"
                             Drop="Editor_Drop"
                             AutomationProperties.Name="笔记正文" />
                    <Canvas x:Name="HeadingGutter" Width="26" HorizontalAlignment="Left" ClipToBounds="True" />
                </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="White" CornerRadius="10">
                <TabControl x:Name="SidebarTabs" BorderThickness="0" Background="White">
                    <TabItem Header="目录">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Padding="8,4" Content="查找" Click="FindNextButton_Click" ToolTip="查找下一处 (Enter / F3)" />
                                <TextBox x:Name="DocumentSearchBox" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="6" materialDesign:HintAssist.Hint="搜索正文…" ToolTip="搜索整篇正文，包含折叠内容 (Ctrl+F)" AutomationProperties.Name="搜索笔记正文" KeyDown="DocumentSearchBox_KeyDown" />
                            </DockPanel>
                            <TextBlock x:Name="OutlineStatusText" Grid.Row="1" Margin="0,6,0,8" TextWrapping="Wrap" Foreground="#475467" FontSize="12" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="CollapseAllButton" Content="全部折叠" Padding="7,4" Margin="0,0,6,0" Click="CollapseAllButton_Click" />
                                <Button x:Name="ExpandAllButton" Content="全部展开" Padding="7,4" Click="ExpandAllButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="3">
                                <ListBox x:Name="OutlineList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OutlineList_MouseLeftButtonUp" PreviewKeyDown="OutlineList_KeyDown" AutomationProperties.Name="笔记目录">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="2,5" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding Indent}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Button Content="{Binding Arrow}" Tag="{Binding}" Click="OutlineFoldButton_Click" Visibility="{Binding FoldVisibility}" Padding="0" Width="22" Height="24" Background="Transparent" Foreground="#3F51B5" BorderThickness="0" ToolTip="展开或折叠章节" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#172033" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="OutlineEmptyText" Margin="4,12" Text="将知识点开头设为章节标题，&#x0a;即可生成目录并折叠正文。&#x0a;&#x0a;Ctrl+Alt+1  一级标题&#x0a;Ctrl+Alt+2  二级标题&#x0a;Ctrl+Alt+3  三级标题&#x0a;Ctrl+Alt+0  恢复正文" Foreground="#475467" TextWrapping="Wrap" FontSize="12" LineHeight="22" IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="GenerateSectionsButton" Grid.Row="4" Content="按编号生成章节…" Margin="0,12,0,0" Padding="8,6" Click="FindNumberedHeadingsButton_Click" />
                            <Border x:Name="NumberedCandidatesPanel" Grid.RowSpan="5" Background="White" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="勾选要设为一级章节的段落" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#172033" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <Button x:Name="ConfirmSectionsButton" Content="生成所选章节" Click="ConfirmNumberedHeadingsButton_Click" Padding="8,6" />
                                        <Button Content="取消" Click="CancelNumberedHeadingsButton_Click" Margin="0,6,0,0" Padding="8,6" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NumberedCandidatesList" /></ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="笔记信息">
                <StackPanel>
                    <TextBlock Text="笔记信息" Foreground="#172033" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,18,0,6" Text="笔记本" Foreground="#667085" FontSize="12" />
                    <ComboBox x:Name="NotebookComboBox"
                              ItemsSource="{Binding EditableNotebooks}"
                              DisplayMemberPath="Name"
                              SelectionChanged="NotebookComboBox_SelectionChanged" />
                    <TextBlock Margin="0,18,0,6" Text="标签" Foreground="#667085" FontSize="12" />
                    <TextBox x:Name="TagsTextBox"
                             materialDesign:HintAssist.Hint="用逗号分隔标签"
                             TextChanged="TagsTextBox_TextChanged"
                             Padding="8" />
                    <TextBlock Margin="0,18,0,4" Text="快捷键" Foreground="#667085" FontSize="12" />
                    <TextBlock Text="Ctrl+S  保存&#x0a;Ctrl+F  搜索&#x0a;Esc  返回笔记墙" Foreground="#475467" FontSize="12" LineHeight="21" />
                    <TextBlock Margin="0,18,0,0" Text="图片可直接粘贴或拖入正文。" TextWrapping="Wrap" Foreground="#667085" FontSize="11" />
                </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border x:Name="SaveFeedbackBorder"
                Grid.Row="2"
                Panel.ZIndex="20"
                Margin="0,20,0,0"
                Padding="14,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#172033"
                CornerRadius="6"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="SaveFeedbackIcon"
                                         Kind="CheckCircleOutline"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Foreground="White" />
                <TextBlock x:Name="SaveFeedbackText"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="已保存"
                           Text="已保存" />
            </StackPanel>
        </Border>

        <Border x:Name="EditorStatusBar"
                Grid.Row="3"
                Padding="20,0"
                Background="White"
                BorderBrush="#DFE4EA"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ResetZoomButton" DockPanel.Dock="Right" Content="100%" Click="ResetZoomButton_Click"
                        ToolTip="Ctrl + 鼠标滚轮缩放正文（50%–200%），点击恢复 100%"
                        AutomationProperties.Name="正文缩放，点击恢复百分之百"
                        Background="Transparent" Foreground="#475467" BorderThickness="0" Padding="8,0" MinWidth="62" />
            <TextBlock x:Name="WordCountText"
                       VerticalAlignment="Center"
                       Foreground="#475467"
                       FontSize="12"
                       Text="字数：0"
                       AutomationProperties.Name="正文字数" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
