<UserControl x:Class="ConvenientNote.Views.RichNoteEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documents="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             PreviewKeyDown="RichNoteEditorControl_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="EditorToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#DFE4EA" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="42" Height="42" Click="BackButton_Click" ToolTip="返回笔记墙 (Esc)" AutomationProperties.Name="返回笔记墙">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" />
                </Button>
                <TextBox x:Name="TitleTextBox"
                         Grid.Column="1"
                         Margin="16,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="EditorContentChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#172033"
                         FontSize="22"
                         FontWeight="SemiBold"
                         AutomationProperties.Name="笔记标题" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveStatus}" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#667085" FontSize="12" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding TogglePinnedCommand}" ToolTip="置顶笔记">
                        <materialDesign:PackIcon Kind="PinOutline" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding ToggleFavoriteCommand}" ToolTip="收藏笔记">
                        <materialDesign:PackIcon Kind="StarOutline" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{Binding MoveToTrashCommand}" ToolTip="移到回收站">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="#B42318" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="18,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ParagraphStyleComboBox" Width="110" Height="34" SelectedIndex="0" SelectionChanged="ParagraphStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="正文" Tag="15" />
                        <ComboBoxItem Content="标题 1" Tag="28" />
                        <ComboBoxItem Content="标题 2" Tag="22" />
                        <ComboBoxItem Content="标题 3" Tag="18" />
                    </ComboBox>
                    <ComboBox x:Name="FontSizeComboBox"
                              Width="76"
                              Height="34"
                              Margin="8,0,0,0"
                              ToolTip="字号"
                              AutomationProperties.Name="字号"
                              SelectionChanged="FontSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="12" Tag="12" />
                        <ComboBoxItem Content="14" Tag="14" />
                        <ComboBoxItem Content="15" Tag="15" IsSelected="True" />
                        <ComboBoxItem Content="16" Tag="16" />
                        <ComboBoxItem Content="18" Tag="18" />
                        <ComboBoxItem Content="20" Tag="20" />
                        <ComboBoxItem Content="24" Tag="24" />
                        <ComboBoxItem Content="28" Tag="28" />
                        <ComboBoxItem Content="32" Tag="32" />
                        <ComboBoxItem Content="36" Tag="36" />
                    </ComboBox>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleBold}" CommandTarget="{Binding ElementName=Editor}" ToolTip="粗体 (Ctrl+B)"><TextBlock Text="B" FontWeight="Bold" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleItalic}" CommandTarget="{Binding ElementName=Editor}" ToolTip="斜体 (Ctrl+I)"><TextBlock Text="I" FontStyle="Italic" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleUnderline}" CommandTarget="{Binding ElementName=Editor}" ToolTip="下划线 (Ctrl+U)"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Click="StrikethroughButton_Click" ToolTip="删除线"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleBullets}" CommandTarget="{Binding ElementName=Editor}" ToolTip="项目符号"><materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.ToggleNumbering}" CommandTarget="{Binding ElementName=Editor}" ToolTip="编号列表"><materialDesign:PackIcon Kind="FormatListNumbered" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignLeft}" CommandTarget="{Binding ElementName=Editor}" ToolTip="左对齐"><materialDesign:PackIcon Kind="FormatAlignLeft" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignCenter}" CommandTarget="{Binding ElementName=Editor}" ToolTip="居中"><materialDesign:PackIcon Kind="FormatAlignCenter" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static documents:EditingCommands.AlignRight}" CommandTarget="{Binding ElementName=Editor}" ToolTip="右对齐"><materialDesign:PackIcon Kind="FormatAlignRight" Width="20" Height="20" /></Button>
                    <Separator Margin="8,0" />
                    <Button Style="{StaticResource EditorToolButton}" Click="TextColorButton_Click" ToolTip="切换文字颜色"><materialDesign:PackIcon Kind="FormatColorText" Width="20" Height="20" Foreground="#3F51B5" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Click="InsertImageButton_Click" ToolTip="插入本地图片"><materialDesign:PackIcon Kind="ImagePlus" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=Editor}" ToolTip="撤销 (Ctrl+Z)"><materialDesign:PackIcon Kind="Undo" Width="20" Height="20" /></Button>
                    <Button Style="{StaticResource EditorToolButton}" Command="{x:Static ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=Editor}" ToolTip="重做 (Ctrl+Y)"><materialDesign:PackIcon Kind="Redo" Width="20" Height="20" /></Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="0">
                <RichTextBox x:Name="Editor"
                             Padding="48,36"
                             BorderThickness="0"
                             Background="White"
                             Foreground="#172033"
                             FontFamily="Segoe UI"
                             FontSize="15"
                             AcceptsTab="True"
                             AllowDrop="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="EditorContentChanged"
                             SelectionChanged="Editor_SelectionChanged"
                             PreviewKeyDown="Editor_PreviewKeyDown"
                             Drop="Editor_Drop"
                             AutomationProperties.Name="笔记正文" />
            </Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="笔记信息" Foreground="#172033" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,18,0,6" Text="笔记本" Foreground="#667085" FontSize="12" />
                    <ComboBox x:Name="NotebookComboBox"
                              ItemsSource="{Binding EditableNotebooks}"
                              DisplayMemberPath="Name"
                              SelectionChanged="NotebookComboBox_SelectionChanged" />
                    <TextBlock Margin="0,18,0,6" Text="标签" Foreground="#667085" FontSize="12" />
                    <TextBox x:Name="TagsTextBox"
                             materialDesign:HintAssist.Hint="用逗号分隔标签"
                             TextChanged="TagsTextBox_TextChanged"
                             Padding="8" />
                    <TextBlock Margin="0,18,0,4" Text="快捷键" Foreground="#667085" FontSize="12" />
                    <TextBlock Text="Ctrl+S  保存&#x0a;Ctrl+F  搜索&#x0a;Esc  返回笔记墙" Foreground="#475467" FontSize="12" LineHeight="21" />
                    <TextBlock Margin="0,18,0,0" Text="图片可直接粘贴或拖入正文。" TextWrapping="Wrap" Foreground="#667085" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="SaveFeedbackBorder"
                Grid.Row="2"
                Panel.ZIndex="20"
                Margin="0,0,0,28"
                Padding="14,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#172033"
                CornerRadius="6"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="SaveFeedbackIcon"
                                         Kind="CheckCircleOutline"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Foreground="White" />
                <TextBlock x:Name="SaveFeedbackText"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="已保存"
                           Text="已保存" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
