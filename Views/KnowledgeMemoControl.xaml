<UserControl x:Class="ConvenientNote.Views.KnowledgeMemoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Control_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="MemoButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#3F51B5" />
        </Style>
    </UserControl.Resources>
    <Border Background="#FFF8C9" BorderBrush="#D8BF66" BorderThickness="1" CornerRadius="10" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="知识点清单" FontSize="17" FontWeight="SemiBold" Foreground="#30291A" VerticalAlignment="Center" />
                <StackPanel x:Name="ReadActions" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="EditMemoButton" Content="编辑" Style="{StaticResource MemoButton}" Click="Edit_Click" ToolTip="修改文字、添加或删除条目" />
                    <Button x:Name="DeleteMemoButton" Content="删除" Style="{StaticResource MemoButton}" Foreground="#9D321C" Click="Delete_Click" ToolTip="删除这张便签的内容，可撤销" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,8,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressText" Foreground="#65542E" FontSize="12" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#65542E" FontSize="12" Text="加载中…" />
            </Grid>
            <Grid Grid.Row="2">
                <ListBox x:Name="Checklist" BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="知识点便签内容">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,6,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#30291A" LineHeight="21">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Margin" Value="0,3,4,3" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.ColumnSpan="2" Click="Heading_Click" Cursor="Hand" Height="Auto"
                                        Visibility="{Binding IsHeading, Converter={StaticResource BoolVisibility}}"
                                        ToolTip="{Binding FoldHint}" AutomationProperties.Name="{Binding Text}"
                                        Background="Transparent" BorderThickness="0" Padding="0,10,0,7"
                                        HorizontalContentAlignment="Stretch" Foreground="#30291A">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="HeadingSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeadingSurface" Property="Background" Value="#18A08122" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeadingSurface" Property="Background" Value="#28A08122" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FoldGlyph}" FontSize="10" Margin="0,5,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" LineHeight="25" />
                                    </Grid>
                                </Button>
                                <CheckBox Grid.Column="1" Width="26" MinHeight="28" VerticalAlignment="Top" Margin="4,0,0,0"
                                          IsChecked="{Binding IsChecked, Mode=OneWay}" Visibility="{Binding HasCheck, Converter={StaticResource BoolVisibility}}"
                                          Click="Check_Click" AutomationProperties.Name="{Binding Text}" ToolTip="标记为已掌握" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="这张便签是空的。&#10;点击“新建”，写下你的知识点。" Visibility="Collapsed"
                           Foreground="#65542E" TextWrapping="Wrap" Margin="0,28" LineHeight="24" />
                <Grid x:Name="EditPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="直接增删文字。分类用 ### 开头，条目末尾用 ☐ 或 ☑。" TextWrapping="Wrap" Foreground="#65542E" FontSize="12" Margin="0,0,0,8" />
                    <TextBox x:Name="MemoEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8"
                             Background="#FFFCED" BorderBrush="#C6AC55" BorderThickness="1" FontSize="13"
                             TextChanged="Editor_TextChanged" AutomationProperties.Name="编辑知识点便签" />
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="SaveMemoButton" DockPanel.Dock="Right" Content="保存" Padding="14,4" Height="32" Margin="8,0,0,0" Click="Save_Click" />
                        <Button x:Name="CancelMemoButton" DockPanel.Dock="Right" Content="取消" Style="{StaticResource MemoButton}" Click="Cancel_Click" />
                        <Button Content="插入 ☐" Style="{StaticResource MemoButton}" HorizontalAlignment="Left" Click="InsertCheck_Click" />
                    </DockPanel>
                </Grid>
            </Grid>
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <Button x:Name="UndoDeleteButton" DockPanel.Dock="Right" Visibility="Collapsed" Content="撤销删除" Style="{StaticResource MemoButton}" Click="UndoDelete_Click" />
                <TextBlock Text="勾选即保存 · 编辑可增删文字" FontSize="11" Foreground="#65542E" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
